# MNSE Shell Adapter - Zsh Integration
# Auto-generated by mnse-shell-adapter install-hooks --shell zsh

autoload -Uz add-zsh-hook

__mnse_zsh_start=0
__mnse_zsh_cmd=""

__mnse_zsh_preexec() {
    __mnse_zsh_start=$(date +%s%3N 2>/dev/null || echo 0)
    __mnse_zsh_cmd="$1"
}

__mnse_zsh_precmd() {
    local exit_code=$?
    if [ -n "$__mnse_zsh_cmd" ]; then
        local now=$(date +%s%3N 2>/dev/null || echo 0)
        local duration=0
        if [ "$__mnse_zsh_start" -gt 0 ]; then
            duration=$((now - __mnse_zsh_start))
        fi
        mnse-shell-adapter record-exec --cmd "$__mnse_zsh_cmd" --exit "$exit_code" --duration-ms "$duration" --cwd "$PWD" --session "$$" >/dev/null 2>&1 &
        __mnse_zsh_cmd=""
    fi
}

add-zsh-hook preexec __mnse_zsh_preexec
add-zsh-hook precmd __mnse_zsh_precmd

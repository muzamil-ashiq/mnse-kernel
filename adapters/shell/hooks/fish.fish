# MNSE Shell Adapter - Fish Integration
# Auto-generated by mnse-shell-adapter install-hooks --shell fish

function __mnse_postexec --on-event fish_postexec
    set -l exit_code $status
    set -l duration $CMD_DURATION
    set -l cmd "$argv[1]"
    set -l cwd "$PWD"
    set -l pid %self

    mnse-shell-adapter record-exec --cmd "$cmd" --exit "$exit_code" --duration-ms "$duration" --cwd "$cwd" --session "$pid" >/dev/null 2>&1 &
end

function __mnse_pwd_change --on-variable PWD
    set -l cwd "$PWD"
    set -l pid %self
    mnse-shell-adapter record-cd --new-dir "$cwd" --session "$pid" >/dev/null 2>&1 &
end
